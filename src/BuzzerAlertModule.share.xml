          <Static>
            <ParameterTypes>
              <!-- 无源蜂鸣器由固件产生方波, 频率用 100 Hz 为单位存 (15..50 -> 1.5..5.0 kHz),
                   这样 6 bit 就够, 也省得在固件里做浮点换算。 -->
              <ParameterType Id="%AID%_PT-BuzzerFrequency" Name="BuzzerFrequency">
                <TypeRestriction Base="Value" SizeInBit="6">
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-15" Text="1.5 kHz" Value="15" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-20" Text="2.0 kHz" Value="20" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-25" Text="2.5 kHz" Value="25" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-30" Text="3.0 kHz" Value="30" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-35" Text="3.5 kHz" Value="35" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-40" Text="4.0 kHz" Value="40" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-45" Text="4.5 kHz" Value="45" />
                  <Enumeration Id="%AID%_PT-BuzzerFrequency_EN-50" Text="5.0 kHz" Value="50" />
                </TypeRestriction>
              </ParameterType>

              <!-- 报警节奏: 与固件里的 cRhythms[] 表一一对应, 改顺序要两边一起改 -->
              <ParameterType Id="%AID%_PT-BuzzerRhythm" Name="BuzzerRhythm">
                <TypeRestriction Base="Value" SizeInBit="3">
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-0" Text="持续长鸣" Value="0" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-1" Text="慢速断续 (0.5 s 响 / 0.5 s 停)" Value="1" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-2" Text="中速断续 (0.25 s 响 / 0.25 s 停)" Value="2" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-3" Text="快速断续 (0.125 s 响 / 0.125 s 停)" Value="3" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-4" Text="双响 (间隔 1 s)" Value="4" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-5" Text="三响 (间隔 1 s)" Value="5" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-6" Text="长鸣 2 s / 停 2 s" Value="6" />
                  <Enumeration Id="%AID%_PT-BuzzerRhythm_EN-7" Text="短响每 10 s" Value="7" />
                </TypeRestriction>
              </ParameterType>
            </ParameterTypes>
            <Parameters>
              <!-- 12 字节 (96 bit)：
                   字节 0  bit7       = 启用蜂鸣器报警
                          bit6..0    = 空闲
                   字节 1  bit7..2    = 报警频率 (6 bit, 单位 100 Hz, 15..50)
                          bit1..0    = 空闲
                   字节 2  bit7..0    = 总线侧 8 个故障点的使能（bit7 = 第 1 个）
                   字节 3  bit7..0    = 辅助侧 8 个故障点的使能
                   字节 4..11         = 16 个故障点各自的报警节奏 (每个 3 bit；每字节放两个：
                                        BitOffset 0 = bit7..5, BitOffset 3 = bit4..2)
                   位序: 同一字节内 BitOffset 0 = 最高位 (7)，与 SC8815PowerSupplyModule.share.xml 一致
                   注: 没有“全局报警节奏”了 —— 节奏直接挂在每个故障点上。 -->
